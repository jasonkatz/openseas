{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "commands": ["pnpm --filter @openseas/server typecheck"]
    }
  },
  "deploy": {
    "aptPackages": ["...", "tini"],
    "startCommand": "cd packages/server && exec tini -s -- node --import tsx src/index.ts"
  }
}
