{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "commands": ["pnpm --filter @openseas/studio-server typecheck"]
    }
  },
  "deploy": {
    "aptPackages": ["...", "git", "tini"],
    "startCommand": "cd packages/studio-server && exec tini -- node --import tsx src/index.ts"
  }
}
