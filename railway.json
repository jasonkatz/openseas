{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @openseas/server typecheck",
    "watchPatterns": [
      "packages/server/**",
      "packages/engine/**",
      "packages/protocol/**",
      "packages/content/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @openseas/server start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
