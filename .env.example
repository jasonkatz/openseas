# Server
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openseas
# Random 32+ char secret used by Better Auth to sign sessions.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the server as the browser reaches it.
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the server: the game and the harness (their
# Vercel URLs in prod; the two Vite dev servers locally).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# Set to true when client and server are on different sites (Vercel + Railway).
CROSS_SITE_COOKIES=false
# Alpha gate. Leave empty to disable the invite requirement.
ALPHA_INVITE_CODE=
# Optional
# Reported by /health. Railway sets RAILWAY_GIT_COMMIT_SHA automatically; leave empty locally.
GIT_COMMIT_SHA=
SENTRY_DSN=
LOG_LEVEL=info

# Client (Vite reads VITE_* at build time)
# Leave empty in dev; Vite proxies /api and /ws to the server.
VITE_SERVER_URL=
VITE_SENTRY_DSN=

# Studio service (packages/studio-server, ADR 0043). It reads DATABASE_URL above: locally it shares
# the game's database, in a schema of its own.
# Signs the owner's session cookie. 16+ characters.
STUDIO_SECRET=change-me-to-another-long-random-string
# The service as the browser reaches it; GitHub is told to come back here.
STUDIO_PUBLIC_URL=http://localhost:8090
# The studio site's origins: the only pages that may sign in, make a link or withdraw one.
STUDIO_ORIGINS=http://localhost:5174,http://localhost:4174
# GitHub logins that may sign in, comma-separated.
STUDIO_OWNERS=
# A GitHub OAuth app for sign-in. Leave empty locally and use the dev login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local only (refused in production): /auth/dev signs this login in with no GitHub.
STUDIO_DEV_LOGIN=dev

# Studio site (Vite reads VITE_* at build time). Empty: no tester links by id; everything else works.
VITE_STUDIO_SERVICE_URL=http://localhost:8090
