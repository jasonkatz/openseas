{
  "id": "swap",
  "version": "0.1",
  "history": [{"version": "0.1", "line": "First version"}],
  "mechanic": "Swap two pieces side by side to line up three or more of one kind and clear them",
  "verb": "swap",
  "round": {
    "tempo": {"kind": "still"},
    "ends": [{"by": "clock", "setting": "roundSeconds"}],
    "logLimit": 2000
  },
  "board": {"shape": "grid", "width": "width", "height": "height", "touch": 4, "rim": false},
  "terrain": [],
  "zones": [],
  "settings": [
    {"id": "roundSeconds", "type": "whole", "default": 150, "min": 10, "max": 1800, "line": "how long a round lasts", "group": "tempo", "unit": "seconds"},
    {"id": "width", "type": "whole", "default": 6, "min": 3, "max": 12, "line": "columns on the board", "group": "board", "unit": "cells"},
    {"id": "height", "type": "whole", "default": 12, "min": 3, "max": 16, "line": "rows on the board", "group": "board", "unit": "cells"},
    {"id": "kinds", "type": "whole", "default": 7, "min": 3, "max": 8, "line": "kinds dealt; more makes a run harder to find", "group": "board"},
    {
      "id": "runPoints",
      "type": "list",
      "default": [0, 0, 3, 8, 15, 24, 35, 48, 63, 80, 99, 120],
      "min": 0,
      "max": 100000,
      "line": "points for a run, an entry for each piece in it",
      "group": "scoring",
      "unit": "points",
      "entries": {"least": 3, "most": 24}
    },
    {
      "id": "cascadePercent",
      "type": "list",
      "default": [100, 200, 300],
      "min": 100,
      "max": 10000,
      "line": "what each step of a cascade multiplies by, an entry for each step",
      "group": "scoring",
      "entries": {"least": 1, "most": 16}
    },
    {
      "id": "togetherPoints",
      "type": "list",
      "default": [0, 10, 25, 45],
      "min": 0,
      "max": 100000,
      "line": "points for clearing several groups in one step, an entry for each group",
      "group": "scoring",
      "unit": "points",
      "entries": {"least": 2, "most": 12}
    },
    {
      "id": "streakPercent",
      "type": "list",
      "default": [100, 110, 120, 130, 140, 150],
      "min": 100,
      "max": 1000,
      "line": "what the streak multiplies by, an entry for each scoring swap in a row",
      "group": "scoring",
      "entries": {"least": 1, "most": 16}
    },
    {"id": "burstPermille", "type": "permille", "default": 12, "min": 0, "max": 200, "line": "chance a new piece is a burst", "group": "deal"},
    {"id": "sweepPermille", "type": "permille", "default": 8, "min": 0, "max": 200, "line": "chance a new piece is a sweep", "group": "deal"},
    {"id": "burstPoints", "type": "whole", "default": 1, "min": 0, "max": 1000, "line": "points for each piece a burst clears", "group": "scoring", "unit": "points"},
    {"id": "sweepPoints", "type": "whole", "default": 2, "min": 0, "max": 1000, "line": "points for each piece a sweep clears", "group": "scoring", "unit": "points"},
    {"id": "floatPermille", "type": "permille", "default": 10, "min": 0, "max": 200, "line": "chance a piece that rises in is a float", "group": "deal"},
    {"id": "liftPoints", "type": "whole", "default": 15, "min": 0, "max": 10000, "line": "points for floats lifted together, times their number squared", "group": "scoring", "unit": "points"},
    {"id": "startRows", "type": "whole", "default": 3, "min": 0, "max": 16, "line": "rows under the line when the round starts", "group": "board", "unit": "cells"},
    {"id": "minRows", "type": "whole", "default": 3, "min": 0, "max": 16, "line": "rows the line never drops below", "group": "board", "unit": "cells"},
    {"id": "dangerRows", "type": "whole", "default": 6, "min": 1, "max": 16, "line": "rows under the line past which it means danger", "group": "board", "unit": "cells"},
    {"id": "riseMoves", "type": "whole", "default": 10, "min": 1, "max": 1000, "line": "swaps that raise the line one row", "group": "tempo", "unit": "moves"},
    {"id": "ventPoints", "type": "whole", "default": 40, "min": 1, "max": 100000, "line": "points that lower the line one row", "group": "scoring", "unit": "points"}
  ],
  "relations": [
    {"is": "ascending", "a": "runPoints"},
    {"is": "ascending", "a": "togetherPoints"},
    {"is": "at-most", "a": "minRows", "b": "startRows"},
    {"is": "at-most", "a": "startRows", "b": "height"},
    {"is": "at-most", "a": "dangerRows", "b": "height"}
  ],
  "deal": {
    "draws": [
      {"id": "kind", "line": "the kind of each new piece, drawn for every cell whether or not another piece takes it", "gives": "kind", "by": "even", "when": "refill", "reads": ["kinds"]},
      {"id": "special", "line": "whether a new piece is a burst or a sweep instead", "gives": "piece", "by": "weighted", "when": "refill", "reads": ["burstPermille", "sweepPermille"]},
      {"id": "float", "line": "whether a piece that rises in is a float instead; the opening board has none", "gives": "piece", "by": "weighted", "when": "refill", "reads": ["floatPermille"]}
    ],
    "checks": [
      {
        "id": "no_run",
        "line": "the opening board holds no run",
        "draws": ["kind"],
        "tries": 20,
        "fallback": "takes the lowest kind that completes no run; two neighbours can rule out two kinds at most, and three or more are dealt"
      }
    ],
    "bounds": [],
    "secrets": []
  },
  "layers": [
    {
      "id": "runs",
      "rule": "a run of three or more of one kind clears, and a longer run pays more",
      "brings": {"draws": ["kind"], "pieces": ["kind"], "events": ["trade", "run", "rise"], "settings": ["runPoints"], "payouts": ["run"]}
    },
    {
      "id": "chains",
      "rule": "each later step of a cascade multiplies, and groups cleared in one step pay a bonus",
      "brings": {"events": ["together"], "settings": ["cascadePercent", "togetherPoints"], "payouts": ["together"], "multipliers": ["cascade"]}
    },
    {
      "id": "streak",
      "rule": "scoring swaps in a row multiply",
      "brings": {"events": ["streak"], "settings": ["streakPercent"], "gauges": ["streak"], "multipliers": ["streak"]}
    },
    {
      "id": "specials",
      "rule": "a burst clears the pieces round where it lands, and a sweep clears every piece of the kind it is swapped with",
      "brings": {
        "draws": ["special"],
        "pieces": ["burst", "sweep"],
        "events": ["burst", "sweep"],
        "settings": ["burstPermille", "sweepPermille", "burstPoints", "sweepPoints"],
        "payouts": ["burst", "sweep"]
      }
    },
    {
      "id": "line",
      "rule": "a float joins no run; it lifts off once it is above the line, and floats lifted together pay by their number squared",
      "brings": {
        "draws": ["float"],
        "pieces": ["float"],
        "events": ["lift", "level"],
        "settings": ["floatPermille", "liftPoints", "startRows", "minRows", "dangerRows", "riseMoves", "ventPoints"],
        "gauges": ["level"],
        "payouts": ["lift"]
      }
    }
  ],
  "ladder": [
    {"stage": "runs", "adds": ["runs"], "advance": {"measure": "best-round", "threshold": 120}},
    {"stage": "chains", "adds": ["chains", "streak"], "advance": {"measure": "best-round", "threshold": 300}},
    {"stage": "specials", "adds": ["specials"], "advance": {"measure": "best-round", "threshold": 450}},
    {"stage": "full", "adds": ["line"]}
  ],
  "evaluation": {
    "tierStarts": {"steady": 220, "sharp": 580, "masterful": 1150, "legendary": 2000},
    "paceWindowSeconds": 10
  },
  "signals": {"in": [{"id": "level", "type": "number", "when": "on-change"}], "out": []},
  "pieces": [
    {"id": "kind", "family": "kinds"},
    {"id": "burst"},
    {"id": "sweep"},
    {"id": "float"}
  ],
  "moves": [
    {"id": "swap", "line": "swipe a piece left or right to trade it with its neighbour", "gesture": "swipe", "fields": {"at": "place", "to": "direction"}}
  ],
  "controls": [],
  "events": [
    {"id": "trade", "line": "two pieces traded cells", "fields": {"a": "place", "b": "place"}, "changes": ["travel"]},
    {"id": "run", "line": "a run of one kind cleared", "fields": {"places": "places", "points": "points"}, "changes": ["leave"]},
    {"id": "burst", "line": "a burst cleared the pieces round it", "fields": {"place": "place", "places": "places", "points": "points"}, "changes": ["leave"]},
    {"id": "sweep", "line": "a sweep cleared every piece of one kind", "fields": {"place": "place", "places": "places", "points": "points"}, "changes": ["leave"]},
    {"id": "together", "line": "several groups cleared in one step", "fields": {"groups": "number", "points": "points"}},
    {"id": "rise", "line": "pieces rose into the gaps and new ones came in from below", "fields": {}, "changes": ["travel", "arrive"]},
    {"id": "lift", "line": "floats above the line lifted off", "fields": {"places": "places", "count": "number", "points": "points"}, "changes": ["leave"]},
    {"id": "level", "line": "the line moved", "fields": {"rows": "number"}},
    {"id": "streak", "line": "the streak grew", "fields": {"count": "number"}}
  ],
  "moment": {"event": "lift", "when": "count > 1", "size": "count", "most": 4},
  "payouts": [
    {"id": "run", "line": "a run pays by its length", "on": ["run"], "counts": "places", "growth": "stepped", "reads": ["runPoints"]},
    {"id": "together", "line": "groups cleared in one step pay a bonus", "on": ["together"], "counts": "groups", "growth": "stepped", "reads": ["togetherPoints"]},
    {"id": "burst", "line": "a burst pays for each piece it clears", "on": ["burst"], "counts": "places", "growth": "linear", "reads": ["burstPoints"]},
    {"id": "sweep", "line": "a sweep pays for each piece it clears", "on": ["sweep"], "counts": "places", "growth": "linear", "reads": ["sweepPoints"]},
    {"id": "lift", "line": "floats lifted together pay by their number squared", "on": ["lift"], "counts": "count", "growth": "superlinear", "reads": ["liftPoints"]}
  ],
  "multipliers": [
    {
      "id": "cascade",
      "line": "each later step of a cascade multiplies what clears in it",
      "scales": ["run", "together", "burst", "sweep"],
      "on": "every clear of a swap and its cascade; never a lift",
      "by": {"table": "cascadePercent", "index": "step"}
    },
    {
      "id": "streak",
      "line": "scoring swaps in a row multiply everything",
      "scales": ["run", "together", "burst", "sweep", "lift"],
      "on": "every event of a swap and its cascade",
      "by": {"table": "streakPercent", "index": "streak"}
    }
  ],
  "streak": {"builds": {"event": "run, burst, sweep or lift", "when": "the swap scored"}, "grace": 1, "breaksOn": []},
  "tasks": [],
  "gauges": [
    {"id": "level", "line": "rows under the line", "most": "height", "danger": "dangerRows"},
    {"id": "streak", "line": "scoring swaps in a row"}
  ],
  "stats": [
    {"id": "best_streak", "line": "the longest streak"},
    {"id": "swaps", "line": "swaps made"},
    {"id": "runs", "line": "runs cleared"},
    {"id": "longest", "line": "the longest run"},
    {"id": "together", "line": "the most groups cleared in one step"},
    {"id": "lifted", "line": "floats lifted"},
    {"id": "best_lift", "line": "the most floats lifted together"}
  ],
  "texts": [
    {"key": "name"},
    {"key": "blurb"},
    {"key": "how_to"},
    {"key": "stage.runs"},
    {"key": "stage.runs_intro"},
    {"key": "stage.chains"},
    {"key": "stage.chains_intro"},
    {"key": "stage.specials"},
    {"key": "stage.specials_intro"},
    {"key": "stage.full"},
    {"key": "stage.full_intro"},
    {"key": "piece.kind_1"},
    {"key": "piece.kind_2"},
    {"key": "piece.kind_3"},
    {"key": "piece.kind_4"},
    {"key": "piece.kind_5"},
    {"key": "piece.kind_6"},
    {"key": "piece.kind_7"},
    {"key": "piece.kind_8"},
    {"key": "piece.burst"},
    {"key": "piece.sweep"},
    {"key": "piece.float"},
    {"key": "event.together", "placeholders": ["groups"]},
    {"key": "event.lift", "placeholders": ["count"]},
    {"key": "gauge.level"},
    {"key": "gauge.streak"},
    {"key": "stat.best_streak"},
    {"key": "stat.swaps"},
    {"key": "stat.runs"},
    {"key": "stat.longest"},
    {"key": "stat.together"},
    {"key": "stat.lifted"},
    {"key": "stat.best_lift"}
  ],
  "teaching": {"preview": false, "hint": false}
}
