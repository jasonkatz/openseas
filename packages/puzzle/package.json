{
  "name": "@openseas/puzzle",
  "version": "0.1.0",
  "private": true,
  "description": "The puzzle domain engine (ADR 0084): runs any puzzle written as a puzzle document and its rules, by docs/puzzles/DOMAIN.md. Pure, with zero runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node ./scripts/check-purity.mjs",
    "witness": "vitest run --config vitest.witness.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "fast-check": "^4.1.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
