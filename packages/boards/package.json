{
  "name": "@openseas/boards",
  "version": "0.1.0",
  "private": true,
  "description": "What the game and the studio render with: the puzzle boards (PixiJS renderers, art, sound), the round runner that streams move logs, and the connection to the server. Renders; never authoritative (ADR 0019).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./look": {
      "types": "./src/look/tokens.ts",
      "default": "./src/look/tokens.ts"
    },
    "./vite": {
      "types": "./build/atlases.d.ts",
      "default": "./build/atlases.js"
    },
    "./pack": {
      "types": "./build/pack.d.ts",
      "default": "./build/pack.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p build",
    "build": "tsc --noEmit && tsc --noEmit -p build",
    "test": "echo \"boards has no unit tests; the studio smoke drives every board\"",
    "lint": "echo no lint"
  },
  "dependencies": {
    "@openseas/content": "workspace:*",
    "@openseas/engine": "workspace:*",
    "@openseas/protocol": "workspace:*",
    "better-auth": "^1.4.0",
    "pixi.js": "^8.6.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
