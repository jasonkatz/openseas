{
  "name": "@openseas/studio-server",
  "version": "0.1.0",
  "private": true,
  "description": "The puzzle studio's service (ADR 0042, ADR 0043): tester links, the owner's sign-in, the owner's drafts (ADR 0045) and Save for a draft's numbers (ADR 0046). Deals no round and knows nothing of the game's accounts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo no lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@openseas/protocol": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
