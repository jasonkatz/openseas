{
  "name": "@openseas/client",
  "version": "0.1.0",
  "private": true,
  "description": "Renders; never authoritative. Vite, React, PixiJS v8.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "echo \"client has no unit tests; run test:smoke\"",
    "test:smoke": "playwright test",
    "lint": "echo no lint"
  },
  "dependencies": {
