{
  "name": "@openseas/client",
  "version": "0.1.0",
  "private": true,
  "description": "The game: one graphical experience (ADR 0018). Renders; never authoritative. Vite, React, PixiJS v8 through @openseas/boards.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "lint": "echo no lint"
  },
  "dependencies": {
    "@openseas/boards": "workspace:*",
    "@openseas/content": "workspace:*",
    "@openseas/engine": "workspace:*",
    "@openseas/protocol": "workspace:*",
    "@types/three": "0.187.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
