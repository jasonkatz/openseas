{
  "name": "@openseas/harness",
  "version": "0.1.0",
  "private": true,
  "description": "The puzzle test harness (ADR 0018, ADR 0019): one page per engine for playing, isolating and inspecting a puzzle. A developer and tester tool; never linked from the game. Renders; never authoritative.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "lint": "echo no lint"
  },
  "dependencies": {
    "@openseas/boards": "workspace:*",
    "@openseas/content": "workspace:*",
    "@openseas/engine": "workspace:*",
    "@openseas/protocol": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
